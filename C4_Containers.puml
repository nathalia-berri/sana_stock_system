@startuml C4_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 - Nível 2 - Containers | Sana Stock System

Person(User, "Usuário", "Funcionário ou Administrador")

System_Boundary(SanaBoundary, "Sana Stock System") {
    Container(WebApp, "Web Application", "React + Vite", "Interface SPA responsiva para gerenciamento de estoque")
    
    Container(API, "API Application", "Python + FastAPI", "API REST responsável pela lógica de negócio, autenticação JWT e controle de estoque")
    
    ContainerDb(DB, "Database", "MariaDB", "Armazena materiais, categorias, funcionários, usuários e movimentações")
}

Rel(User, WebApp, "Utiliza via navegador", "HTTPS")
Rel(WebApp, API, "Consome API REST", "JSON/HTTPS")
Rel(API, DB, "Lê e grava dados", "SQLAlchemy / SQL")

@enduml